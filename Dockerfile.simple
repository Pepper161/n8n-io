# Simple n8n deployment using official image
FROM n8nio/n8n:latest

# Set environment variables for Cloud Run
ENV N8N_HOST=0.0.0.0
ENV N8N_PROTOCOL=https
ENV DB_TYPE=sqlite
ENV N8N_ENCRYPTION_KEY=${N8N_ENCRYPTION_KEY:-mysecretkey123}

# Create data directory and set permissions
USER root
RUN mkdir -p /home/node/.n8n && chown -R node:node /home/node/.n8n

# Create a startup script that uses the PORT environment variable
RUN echo '#!/bin/sh\nexport N8N_PORT=${PORT:-8080}\nexec n8n start' > /home/node/start.sh && chmod +x /home/node/start.sh && chown node:node /home/node/start.sh

USER node

# Expose port (Cloud Run will set PORT dynamically)
EXPOSE $PORT

# Start n8n with dynamic port
CMD ["/home/node/start.sh"]