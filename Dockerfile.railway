FROM node:20-alpine

WORKDIR /app

RUN npm install -g pnpm

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY patches ./patches
COPY packages ./packages
COPY tsconfig.json biome.jsonc ./

RUN pnpm install --frozen-lockfile --ignore-scripts

# Build only core packages needed for n8n
RUN pnpm --filter="@n8n/constants" build
RUN pnpm --filter="@n8n/utils" build  
RUN pnpm --filter="@n8n/config" build
RUN pnpm --filter="@n8n/db" build
RUN pnpm --filter="n8n-workflow" build
RUN pnpm --filter="n8n-core" build
RUN pnpm --filter="n8n" build

EXPOSE 5678

CMD ["pnpm", "start"]
